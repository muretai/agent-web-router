{
  "name": "@muretai/agent-web-router",
  "version": "0.5.0",
  "description": "Help your agent behave on the websites it visits. A person already in the tab keeps the page -- this does not replace WebMCP. When the agent is alone and the site already published an Agent Card, it takes that door, checks it is theirs, and knocks. It does not follow a pointer to someone else's door. Zero dependencies.",
  "type": "module",
  "main": "agent-web-router.mjs",
  "exports": {
    ".": "./agent-web-router.mjs"
  },
  "bin": {
    "agent-web-router": "./bin/agent-web-router.mjs"
  },
  "files": [
    "agent-web-router.mjs",
    "bin/",
    "spec/",
    "scripts/distill/",
    "diagrams/",
    "SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "probe": "node bin/agent-web-router.mjs probe",
    "distill": "node scripts/distill/loop.mjs",
    "distill:record": "node scripts/distill/record.mjs",
    "distill:measure": "node scripts/distill/measure.mjs"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "agent",
    "a2a",
    "agent-card",
    "webmcp",
    "mcp",
    "handoff",
    "did",
    "ed25519",
    "muretai"
  ],
  "license": "MIT",
  "author": "Muretai",
  "homepage": "https://muretai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muretai/agent-web-router.git"
  },
  "bugs": {
    "url": "https://github.com/muretai/agent-web-router/issues"
  }
}
