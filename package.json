{
  "name": "@muretai/agent-web-router",
  "version": "0.5.0",
  "description": "Before your agent opens a browser: find how a website wants to be entered — Agent Card, MCP server, or WebMCP in the page. MCP and WebMCP are different. No person in the tab? Take Card/MCP; do not scrape the page. Any A2A door. Zero dependencies.",
  "type": "module",
  "main": "agent-web-router.mjs",
  "exports": {
    ".": "./agent-web-router.mjs"
  },
  "bin": {
    "agent-web-router": "./bin/agent-web-router.mjs"
  },
  "files": [
    "agent-web-router.mjs",
    "bin/",
    "spec/",
    "scripts/distill/",
    "diagrams/",
    "SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "probe": "node bin/agent-web-router.mjs probe",
    "distill": "node scripts/distill/loop.mjs",
    "distill:record": "node scripts/distill/record.mjs",
    "distill:measure": "node scripts/distill/measure.mjs"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "agent",
    "a2a",
    "agent-card",
    "webmcp",
    "mcp",
    "handoff",
    "did",
    "ed25519",
    "muretai"
  ],
